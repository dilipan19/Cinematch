<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://cinematch.app/tizen"
        version="1.0.0"
        viewmodes="maximized">
  <tizen:application id="cinematch.CineMatch" package="cinematch" required_version="6.0"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <icon src="icon.png"/>
  <name>CineMatch</name>
  <description>OTT movie discovery for Samsung Smart TV (Tizen)</description>
  <author href="https://cinematch.app" email="dev@cinematch.app">CineMatch</author>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"/>
</widget>
